{
  "name": "dsh-codebase-memory-cli",
  "version": "0.1.0",
  "description": "DSH plugin for the local codebase-memory CLI: it spawns the CLI, parses its JSON, keeps the graph current by verifying index coverage of every git change before a read, and exposes a curated tool set instead of the whole operation catalog.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codebase-memory",
    "code-intelligence",
    "knowledge-graph",
    "cli"
  ],
  "author": "ExLei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ExLei/dsh-codebase-memory-cli.git"
  },
  "homepage": "https://github.com/ExLei/dsh-codebase-memory-cli#readme",
  "bugs": {
    "url": "https://github.com/ExLei/dsh-codebase-memory-cli/issues"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
